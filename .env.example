# No required env vars — Docker socket is reached via the socket-proxy service

# Background metrics sampling, in seconds.
#   30 (default) → record history continuously, even with no dashboard open
#   0            → sample on demand only (no load while idle)
SAMPLE_INTERVAL=30

# How long to keep metric history in the SQLite database.
#   24 (default) → 24-hour retention, ~5-6 MB for 25 containers
#   168          → 7-day retention, ~38 MB for 25 containers
# Graph range selectors adapt automatically to the configured retention.
RETENTION_HOURS=24

# API token validation (leave empty to skip)
# To monitor multiple tokens of the same type, append a double-underscore
# label to the env var name, e.g.:
#   ANTHROPIC_API_KEY__work=sk-ant-...
#   ANTHROPIC_API_KEY__personal=sk-ant-...
# They appear as separate cards: "Anthropic (work)" / "Anthropic (personal)".
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI (v1 API) — resource endpoint + key. Endpoint must include the
# /openai/v1 suffix, e.g. https://myresource.openai.azure.com/openai/v1:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Google Cloud service account key — raw JSON or base64-encoded JSON:
#   GOOGLE_CREDENTIALS_JSON=$(base64 -w0 /path/to/key.json)
GOOGLE_CREDENTIALS_JSON=
HUGGINGFACE_TOKEN=
GROQ_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
SCALEWAY_API_KEY=
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com

# Optional Google OAuth login gate (leave all three empty to disable — the
# app then behaves exactly as before, relying on Caddy Basic Auth or
# whatever the reverse proxy already provides). When all three are set,
# every page and API route requires signing in with one of the listed
# Google accounts; the allowlist is re-checked on every request, so
# removing an email here revokes access immediately (after a container
# recreate — env var changes need `docker compose up -d`, not `restart`).
#   1. Create an OAuth 2.0 Client ID (Web application) in Google Cloud
#      Console → APIs & Services → Credentials.
#   2. Add an Authorized redirect URI: https://<your-domain>/auth/callback
#   3. Fill in the three vars below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated, exact match (case-insensitive) — no domain wildcards:
GOOGLE_OAUTH_ALLOWED_EMAILS=
# Signs session cookies. Set this to a fixed random value (e.g.
# `openssl rand -base64 32`) so sessions survive a container restart —
# otherwise a new random key is generated each start and everyone is
# signed out.
GOOGLE_OAUTH_SESSION_SECRET=
